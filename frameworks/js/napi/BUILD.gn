import("//build/ohos.gni")
import("//base/customization/assessment_configuration_service/assessment.gni")

ohos_shared_library("assessment_napi") {
  sources = [
    "assessment/assessment_napi.cpp",
    "assessment/js_assessment_callback.cpp",
  ]

  configs = []

  defines = [ "AMS_LOG_TAG = \"AssessmentService\"" ]
  defines += [ "AMS_LOG_DOMAIN = 0xD003950" ]

  deps = [
    "${assessment_innerkits_path}/assessment_service:assessment_manager",
  ]

  external_deps = [
    "ability_base:want",
    "ability_runtime:ability_context_native",
    "ability_runtime:napi_base_context",
    "ability_runtime:napi_common",
    "ability_runtime:runtime",
    "bundle_framework:appexecfwk_base",
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_single",
    "napi:ace_napi",
  ]

  relative_install_dir = "module/customization"
  subsystem_name = "customization"
  part_name = "assessment_configuration_service"
}