{
    "name": "@ohos/assessment",
    "description": "Assessment Configuration Service for device assessment and configuration management",
    "version": "4.0",
    "license": "Apache License 2.0",
    "segment": {
        "destPath": "base/customization/assessment_configuration_service"
    },
    "component": {
        "name": "assessment_configuration_service",
        "subsystem": "customization",
        "syscap": [
            "SystemCapability.Customization.AssessmentConfiguration"
        ],
        "features": [],
        "adapted_system_type": [
            "standard"
        ],
        "rom": "~500KB",
        "ram": "~200KB",
        "deps": {
            "components": [
                "ability_base",
                "ability_runtime",
                "access_token",
                "bundle_framework",
                "c_utils",
                "hilog",
                "hitrace",
                "init",
                "ipc",
                "safwk",
                "samgr",
                "eventhandler",
                "accessibility",
                "call_manager",
                "core_service",
                "state_registry",
                "device_manager",
                "graphic_2d",
                "window_manager",
                "napi",
                "input"
            ],
            "third_party": []
        },
        "build": {
            "sub_component": [
                "//base/customization/assessment_configuration_service/services/assessment_service:assessmentsvcs",
                "//base/customization/assessment_configuration_service/services/assessment_service:assessment_service.cfg",
                "//base/customization/assessment_configuration_service/services/assessment_service/sa_profile:assessment_service_sa_profile",
                "//base/customization/assessment_configuration_service/services/assessment_service/etc/param:assessment.para",
                "//base/customization/assessment_configuration_service/services/assessment_service/etc/param:assessment.para.dac",
                "//base/customization/assessment_configuration_service/interfaces/inner_api/assessment_service:assessment_manager",
                "//base/customization/assessment_configuration_service/frameworks/js/napi:assessment_napi"
            ],
            "inner_kits":[
                {
                    "type": "so",
                    "name": "//base/customization/assessment_configuration_service/interfaces/inner_api/assessment_service:assessment_manager",
                    "header": {
                        "header_files": [
                            "assessment_service.h",
                            "assessment_callback_code.h",
                            "hilog_tag_wrapper.h",
                            "assessment_error_code.h"
                        ],
                        "header_base": "//base/customization/assessment_configuration_service/interfaces/inner_api/assessment_service/include"
                    }
                }
            ]
        }
    }
}
